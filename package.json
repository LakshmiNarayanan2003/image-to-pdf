{
  "name": "pix2pdf",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Private browser-local image to PDF conversion",
  "license": "MIT",
  "engines": {
    "node": ">=24 <25"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/LakshmiNarayanan2003/image-to-pdf.git"
  },
  "homepage": "https://lakshminarayanan2003.github.io/image-to-pdf/",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "node scripts/licenses.mjs && tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "fixtures": "node scripts/generate-fixtures.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "check:assets": "node scripts/check-assets.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build && npm run check:assets && npm run check:docs",
    "verify": "npm run check && npm audit --audit-level=moderate && npm run test:e2e"
  },
  "dependencies": {
    "gifuct-js": "^2.1.2",
    "libheif-js": "^1.23.5",
    "lucide-react": "^1.58.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tiff": "^7.1.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@napi-rs/canvas": "^1.0.11",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "jsdom": "^30.1.3",
    "pdfjs-dist": "^6.4.299",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
